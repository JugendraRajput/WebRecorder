<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:orientation="vertical"
    tools:context=".BatchAutoProcessActivity">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:fitsSystemWindows="true"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:popupTheme="@style/Theme.Material3.DayNight"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="#94A3B8" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Mobile Capacity & Benchmark Test -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Device Capacity Benchmark"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_device_hardware"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Detecting hardware..."
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/text_benchmark_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_pill_counter"
                        android:padding="10dp"
                        android:text="Click below to test how many concurrent requests your device can handle."
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="@color/text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_run_benchmark"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Test Mobile Capacity (Probe 10-100 Threads)"
                        android:textColor="@color/button_tonal_text"
                        android:textStyle="bold"
                        app:backgroundTint="@color/button_tonal_bg"
                        app:cornerRadius="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Configuration & Source -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Batch Source &amp; Concurrency"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <!-- Source Selector -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Batch Source:"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/text_selected_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="No Excel folder or sheet selected"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <!-- Buttons Row: Pick Folder vs Pick Single Sheet -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_pick_folder"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:text="Choose Folder"
                                android:textColor="@color/button_tonal_text"
                                android:textStyle="bold"
                                app:backgroundTint="@color/button_tonal_bg"
                                app:cornerRadius="10dp"
                                app:icon="@drawable/ic_folder"
                                app:iconTint="@color/button_tonal_text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_pick_excel"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="Single Sheet"
                                android:textColor="@color/text_primary"
                                app:cornerRadius="10dp"
                                app:strokeColor="@color/card_stroke" />
                        </LinearLayout>

                        <!-- Quick Load Button for /sdcard/Movies/Excel/ -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_quick_load_device"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Scan /Movies/Excel/ (16 Sheets)"
                            android:textColor="@android:color/white"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <!-- Batch Size, Concurrency & Cool-off row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- Batch size input -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1.2"
                            android:hint="Batch Size (0=All)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_batch_size"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="200"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Thread count input -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:hint="Threads (1-32)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_thread_count"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:text="20"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Cool-off delay input -->
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Cool-off (s)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_cool_off"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:text="1.5"
                                android:textColor="@color/text_primary" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Filter checkbox -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_filter_unwanted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checked="true"
                        android:text="Filter out sex/abuse-related titles"
                        android:textColor="@color/text_primary" />

                    <!-- Skip existing checkbox -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/check_skip_existing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Skip items already saved offline"
                        android:textColor="@color/text_primary" />

                    <!-- Offline Engine Selector -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Offline Saving Engine:"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="@color/text_secondary"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/radio_group_engine"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:id="@+id/radio_engine_webview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Native Recorder Engine (WebView saveWebArchive .mht)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="Exact engine from main recorder: full Chromium rendering with lazy-load image trigger, cool-off period, and all embedded images in .mht."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <RadioButton
                            android:id="@+id/radio_engine_inliner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Advanced Turbo Image Inliner (Multi-Threaded)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="32dp"
                            android:text="Fast parallel background threads that download HTML &amp; fetch all images, embedding them as Base64 data URIs."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </RadioGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Live Statistics Dashboard -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time Processing Dashboard"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />

                    <!-- Progress bar -->
                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        app:indicatorColor="@color/color_offline_badge"
                        app:trackColor="@color/card_stroke"
                        app:trackCornerRadius="4dp" />

                    <!-- Stats Row 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_stat_progress"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Progress: 0 / 0 (0%)"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_stat_threads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Threads: 0"
                            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                            android:textColor="@color/secondary" />
                    </LinearLayout>

                    <!-- Stats Row 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_stat_saved"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Saved: 0"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/color_offline_badge"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/text_stat_skipped"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Skipped/Filter: 0"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/text_stat_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Speed: 0/min"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <!-- Action buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_start"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Start Batch"
                            android:textStyle="bold"
                            app:backgroundTint="@color/color_offline_badge"
                            app:cornerRadius="10dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pause"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:text="Pause"
                            android:textColor="@color/button_tonal_text"
                            app:backgroundTint="@color/button_tonal_bg"
                            app:cornerRadius="10dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_open_viewer"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Open Saved Pages in Main Viewer"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/card_stroke" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Live Event Log Console -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#0F172A"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#1E293B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Processing Log:"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                        android:textColor="#94A3B8" />

                    <TextView
                        android:id="@+id/text_live_log"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="6dp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:scrollbars="vertical"
                        android:text="[Ready] Select an Excel file and run benchmark or start batch."
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
    <FrameLayout
        android:id="@+id/hidden_webview_container"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />
</LinearLayout>
