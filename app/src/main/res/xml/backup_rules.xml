<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower. Offline pages can be gigabytes and are restored from the cloud,
     and the GitHub token must never leave the device. -->
<full-backup-content>
    <exclude domain="file" path="offline_pages/" />
    <exclude domain="file" path="sync_state/" />
    <exclude domain="sharedpref" path="webrecorder_sync.xml" />
</full-backup-content>
