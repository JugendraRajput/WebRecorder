<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="offline_pages/" />
        <exclude domain="file" path="sync_state/" />
        <exclude domain="sharedpref" path="webrecorder_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="webrecorder_sync.xml" />
    </device-transfer>
</data-extraction-rules>
